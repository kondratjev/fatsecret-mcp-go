# FatSecret API credentials: https://platform.fatsecret.com/ → My Account → API Keys
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Consumer secret for the OAuth1 profile flow (3-legged); usually same value as the client secret on new keys
FATSECRET_CONSUMER_SECRET=

# Uncomment to serve stateless Streamable HTTP on /mcp (+ /healthz) instead of stdio
# PORT=8000

# --- Self-hosted (Docker) ---
# Time zone for the default diary "today" (e.g. Europe/Moscow)
TZ=UTC
# Public host name (an IP works too, e.g. 203-0-113-5.sslip.io)
DOMAIN=
# Long random string guarding the MCP endpoint: openssl rand -hex 24
MCP_SECRET=
